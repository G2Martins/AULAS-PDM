# Copie este arquivo para .env e ajuste valores ao seu ambiente.
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env (Windows cmd)

# String de conexão MySQL (Prisma)
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/gestao_financeira"

# Porta HTTP do Express
PORT=3000

# Segredo do JWT — TROQUE em produção (use 32+ chars aleatórios)
# Gerar:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-este-segredo-em-producao"

# Tempo de expiração do token (ex.: 7d, 24h, 60m)
JWT_EXPIRES_IN="7d"
